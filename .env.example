# ─── Reactor (Happy Oyster world model) ───────────────────────────────
# Get this from your Reactor dashboard. Starts with "rk_..."
# NEVER expose this to the browser — it is only used server-side
# in app/api/token/route.ts to mint short-lived JWTs.
REACTOR_API_KEY=rk_your_api_key_here

# ─── Kimi (our agent / lesson-planner brain) ──────────────────────────
# OpenAI-compatible endpoint for your hosted Kimi.
# Self-hosted on Modal: https://<workspace>--ep-kimi-k3-server.us-west.modal.direct/v1
# Or Moonshot's public API: https://api.moonshot.ai/v1
KIMI_BASE_URL=https://your-kimi-endpoint/v1

# Auth option 1 — Modal proxy auth (if your endpoint has proxy auth ON).
# Get these from https://modal.com/settings → API Tokens (or `modal token new`)
# for the SAME workspace that owns the endpoint.
KIMI_MODAL_KEY=ak_...
KIMI_MODAL_SECRET=as_...

# Auth option 2 — plain Bearer key (Moonshot public API, or an open endpoint).
# Leave KIMI_MODAL_KEY/KIMI_MODAL_SECRET empty to use this instead.
KIMI_API_KEY=

# Model name your endpoint serves (check GET /v1/models on your endpoint)
KIMI_MODEL=kimi-k3

# ─── Reference-image generation (pick ONE, best first) ────────────────
# Option 1 — fal.ai FLUX.1 [dev]: best quality, ~$0.025/image.
#   Get a key at https://fal.ai/dashboard/keys
FAL_KEY=
# Option 2 — Google Gemini image ("nano banana"): great quality, free tier.
#   Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
# Option 3 — no keys at all: falls back to free Pollinations Flux.

# ─── P2 Prop Foundry (self-hosted TRELLIS.2-4B on Modal) ────────────────
# Provider: "modal" (self-host, default when TRELLIS_MODAL_URL set) or
# "fal" (legacy hosted fal-ai/trellis — needs FAL_KEY).
FOUNDRY_PROVIDER=modal
# Deploy modal/trellis2_app.py (`modal deploy`), then paste the generate URL:
# (long workspace names get a hash-suffixed URL — copy the EXACT one from deploy output)
TRELLIS_MODAL_URL=https://<workspace>--edworld-trellis2-forge-trellis2forge-generate.modal.run
# Phase C — self-hosted FLUX.2-klein-4B ref-image service (modal/flux_ref_app.py).
# PRIMARY ref-image source when set: our own GPU, no 429s, ~1-3s/image,
# The Modal foundry fails closed; it never falls back to external image providers.
FLUX_MODAL_URL=https://<workspace>--edworld-flux-ref-fluxref-generate.modal.run
# Shared secret sent as X-Foundry-Key header; must equal the Modal secret:
#   modal secret create foundry-auth FOUNDRY_SHARED_SECRET=<openssl rand -hex 32>
FOUNDRY_SHARED_SECRET=
# Max hero props auto-compiled per realworld plan (0 disables the Director step).
# UNSET = no cap: every labeled object is forged (owner call 2026-09-05).
#FOUNDRY_MAX_PROPS=2
# Parallel forges per plan (Phase C). Default 6 — matches TRELLIS max_containers.
# Ref images come from OUR FLUX service (no 429s), so parallel is safe.
# Set 1 for legacy serial behavior.
#FOUNDRY_PARALLEL=6

# Durable scene generation (persistent Node host; not ephemeral/serverless)
# Run npm run build:worker, then npm run worker alongside the Next server.
SCENE_APP_ORIGIN=http://localhost:3001
# Optional overrides; defaults live in .cache. App and worker must share this DB.
#SCENE_JOBS_DB=/var/lib/edworld/scene-jobs.sqlite
#SCENE_REVIEW_DIR=/var/lib/edworld/reviews
#CHROME_EXECUTABLE=/usr/bin/chromium
# Required in production: private demo access, HTTP Basic username is ed.
# Put behind HTTPS. Use a strong unique password. This is not public account auth.
ED_ACCESS_PASSWORD=

# Agent-world infrastructure: optional HTTP language adapter (full completions URL).
# Private Qwen RPC bridge is the default agent runner; this HTTP alternative is explicit.
AGENT_MODAL_LLM_URL=
AGENT_MODAL_LLM_MODEL=
